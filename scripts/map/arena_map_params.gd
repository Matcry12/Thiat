class_name ArenaMapParams
extends RefCounted
## ArenaMap helper: copies the ArenaMap exports into MapGen.Params. Moved out of arena_map.gd unchanged (the map is passed in).


static func make_params(m: ArenaMap) -> MapGen.Params:
	var p := MapGen.Params.new()
	var cell := m.cell_px()
	var scale := float(m.map_cols * m.map_rows) / ArenaMap.REF_CELLS
	p.cell = cell
	p.world = m.map_size()
	p.cols = m.map_cols
	p.rows = m.map_rows
	p.patch_count = roundi(m.patch_count * scale)
	p.patch_min_size = m.patch_min_size
	p.patch_max_size = m.patch_max_size
	p.noise_frequency = m.noise_frequency
	p.patch_noise_threshold = m.patch_noise_threshold
	p.deco_density = m.deco_density
	p.deco_min_spacing = m.deco_min_spacing
	p.obstacle_count = roundi(m.obstacle_count * scale)
	p.obstacle_min_spacing = m.obstacle_min_spacing
	p.spawn_clear_radius = m.spawn_clear_radius
	p.border_density = m.border_density
	p.dark_grass_chance = m.dark_grass_chance
	p.agent_radius = m.agent_radius
	p.island_on = m.island_on
	p.cont_period = m.cont_period
	p.cont_octaves = m.cont_octaves
	p.cont_gain = m.cont_gain
	p.cont_radial = m.cont_radial
	p.cont_edge_cells = m.cont_edge_cells
	p.land_share = m.land_share
	p.neck_cells = m.neck_cells
	p.neck_boost = m.neck_boost
	p.water_on = m.water_on
	p.river_period = m.river_period
	p.river_octaves = m.river_octaves
	p.river_w_inland = m.river_w_inland
	p.river_w_sea = m.river_w_sea
	p.river_grow_dist = m.river_grow_dist
	p.river_rough_max = m.river_rough_max
	p.river_min_cells = m.river_min_cells
	p.river_inland_min = m.river_inland_min
	p.lake_humid_min = m.lake_humid_min
	p.lake_inland_min = m.lake_inland_min
	p.lake_rough_max = m.lake_rough_max
	p.lake_min_cells = m.lake_min_cells
	p.water_min_cells = m.water_min_cells
	p.river_big_n = m.river_big_n
	p.river_big_w_inland = m.river_big_w_inland
	p.river_big_w_sea = m.river_big_w_sea
	p.river_big_reach = m.river_big_reach
	p.lake_big_n = m.lake_big_n
	p.lake_big_r_min = m.lake_big_r_min
	p.lake_big_r_max = m.lake_big_r_max
	p.lake_big_on_river = m.lake_big_on_river
	p.lake_pond_n = m.lake_pond_n
	p.lake_pond_r_min = m.lake_pond_r_min
	p.lake_pond_r_max = m.lake_pond_r_max
	p.lake_pond_on_river = m.lake_pond_on_river
	p.lake_pond_wet_min = m.lake_pond_wet_min
	p.lake_pond_wet_period = m.lake_pond_wet_period
	p.lake_pond_stretch_min = m.lake_pond_stretch_min
	p.lake_pond_stretch_max = m.lake_pond_stretch_max
	p.lake_pond_blobs_min = m.lake_pond_blobs_min
	p.lake_pond_blobs_max = m.lake_pond_blobs_max
	p.lake_warp = m.lake_warp
	p.lake_shape_period = m.lake_shape_period
	p.lake_gap = m.lake_gap
	p.shore_cells = m.shore_cells
	p.shallow_min = m.shallow_min
	p.shallow_max = m.shallow_max
	p.coast_cells = m.coast_cells
	p.home_clear_cells = m.home_clear_cells
	p.corridor_half = m.corridor_half
	p.climate_temp_period = m.climate_temp_period
	p.climate_humid_period = m.climate_humid_period
	p.climate_rough_period = m.climate_rough_period
	p.climate_warp_period = m.climate_warp_period
	p.climate_warp_amp = m.climate_warp_amp
	p.climate_octaves = m.climate_octaves
	p.climate_w_temp = m.climate_w_temp
	p.climate_w_humid = m.climate_w_humid
	p.climate_w_rough = m.climate_w_rough
	p.forest_margin = m.forest_margin
	p.climate_warp_octaves = m.climate_warp_octaves
	p.beach_noise_period = m.beach_noise_period
	p.beach_noise_octaves = m.beach_noise_octaves
	p.biome_smooth_half = m.biome_smooth_half
	p.boss_land_cells = m.boss_land_cells
	p.biome_smooth_passes = m.biome_smooth_passes
	p.biome_min_blob = m.biome_min_blob
	p.beach_min = m.beach_min
	p.beach_max = m.beach_max
	p.cold_beach_t = m.cold_beach_t
	p.home_calm_cells = m.home_calm_cells
	p.home_calm_fade = m.home_calm_fade
	p.calm_temp = m.calm_temp
	p.calm_humid = m.calm_humid
	p.calm_rough = m.calm_rough
	p.legacy_tiles = m.map_cols * m.map_rows <= m.legacy_tiles_max_cells
	p.band_lo = m.band_lo
	p.band_hi = m.band_hi
	p.fir_group_radius = m.fir_group_radius
	p.pp = m.style.pixel_plains
	p.trees_on = m.trees_on and not (p.pp != null and p.pp.hide_trees)
	p.veg_on = m.veg_on and not (p.pp != null and p.pp.hide_veg)
	p.tree_fade_lo = m.tree_fade_lo
	p.tree_fade_hi = m.tree_fade_hi
	p.veg_density_period = m.veg_density_period
	p.rock_group_radius = m.rock_group_radius
	p.copper_near_home_cells = m.copper_near_home_cells
	p.age_core = m.age_core
	p.age_mid = m.age_mid
	p.core_old = m.core_old
	p.mid_small = m.mid_small
	p.edge_young = m.edge_young
	p.edge_sapling = m.edge_sapling
	p.clearing_per_cells = m.clearing_per_cells
	p.clearing_r_min = m.clearing_r_min
	p.clearing_r_max = m.clearing_r_max
	p.tree_home_clear = m.tree_home_clear
	p.tree_jitter = m.tree_jitter
	p.smooth_passes = m.smooth_passes
	p.border_jitter = m.border_jitter
	p.min_island_cells = m.min_island_cells
	p.beach_cells = m.beach_cells
	p.path_on = m.path_on
	p.path_width = m.path_width
	p.path_branches = m.path_branches
	p.path_wobble = m.path_wobble
	p.camp_radius = m.camp_radius
	p.dirt_patches = m.dirt_patches
	p.dirt_patch_size = m.dirt_patch_size
	if m.yard != null:
		p.yard = true
		p.yard_nodes = m.yard.node_list(m._player_spawn)
		p.water_on = false
		p.veg_on = false
		p.legacy_tiles = false
	p.zone = m._zone
	p.spawns = m._spawns
	p.player_spawn = m._player_spawn
	return p
